# Corral web app (Next.js). Copy to client/.env.local:
#   cp .env.example .env.local
# Next loads .env.local and does not commit it. The API is server/.env.example.
# These must agree with the API:
#   NEXT_PUBLIC_API_URL  = the API origin (uvicorn on :8000)
#   SESSION_COOKIE_NAME  = server SESSION_COOKIE_NAME
# The API must set FRONTEND_URL and CORS_ORIGINS to this app
# (http://localhost:3000). Use localhost on both sides, not 127.0.0.1,
# so the session cookie reaches the app.
#
# NEXT_PUBLIC_* values are inlined at build time. Set them before
# `pnpm build` (and on the deploy), not only when the server starts.

# API origin only — no path, query, or hash.
# Dev default when unset: http://localhost:8000. Required in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The app (/app, /sign-in, /onboarding, the styleguide and the unlisted landings).
# Unset: only the pages the landing links to exist, everything else is the 404.
# pnpm dev sets 1 locally. Set it on a deployed app frontend too.
# Read by the Next server (proxy.ts).
# CORRAL_APP=1

# Design review: 1 or true turns off auth and shows sample data.
# Leave unset for a real app. Never set this on a deploy.
# NEXT_PUBLIC_DESIGN_REVIEW=

# Deadline for each API call, in milliseconds (integer 100–120000). Default 10000.
# NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Name of the sealed session cookie the API sets. Must match the API.
# Default wos_session. Read by the Next server (proxy.ts); not inlined
# into the browser the way NEXT_PUBLIC_* values are.
# SESSION_COOKIE_NAME=wos_session

# Where every "Status" link goes: an http(s) URL, a /path, or a #fragment.
# Default #status. Inlined at build time.
# NEXT_PUBLIC_STATUS_URL=#status

# Paddle.js overlay. The client token is public (test_… in sandbox) but still an env value.
# Checkout does not grant access; the API does, after a verified webhook.
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
