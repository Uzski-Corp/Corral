# Corral web app. Copy to client/.env.local:
#   cp .env.example .env.local
#
# This app has no third-party API keys. Sign-in is WorkOS, and those keys
# live in server/.env (WORKOS_API_KEY, WORKOS_CLIENT_ID, WORKOS_COOKIE_PASSWORD).
#
# NEXT_PUBLIC_* values are inlined at build time. Set them before `pnpm build`.
# The browser calls the API, so this origin is localhost even under Compose.

# API origin only. No path. Dev default if unset: http://localhost:8000.
# Required in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# 1 or true: design review, no auth, sample data. Never set this on a deploy.
# NEXT_PUBLIC_DESIGN_REVIEW=

# Per-request deadline, milliseconds, integer 100–120000. Default 10000.
# NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Sealed session cookie. Must match server SESSION_COOKIE_NAME. Default wos_session.
# Read by the Next server (proxy.ts), not inlined into the browser.
# SESSION_COOKIE_NAME=wos_session

# Status links: an http(s) URL, a /path, or a #fragment. Default #status.
# NEXT_PUBLIC_STATUS_URL=#status
