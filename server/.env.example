# Services this API calls. Copy to server/.env and fill the blanks.
# Third-party keys do not go in the Next.js app. See client/.env.example.
#
# Sign-in (email code and Continue with Google) is WorkOS AuthKit.
# Without the three values below, local boot still works and
# POST /api/v1/auth/code/send returns 503 ("Couldn't send your code").
# Dashboard: https://dashboard.workos.com
# Redirect URI to register there: http://localhost:8000/api/v1/auth/callback
# WORKOS_COOKIE_PASSWORD is not issued by WorkOS. Generate it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Knowledge-base embeddings. Default provider is local hashing, so this key
# stays empty. Set KB_EMBEDDING_PROVIDER=openai to call a compatible API.
# KB_EMBEDDING_PROVIDER=hashing
# KB_EMBEDDING_API_BASE=https://api.openai.com/v1
# KB_EMBEDDING_API_KEY=
# KB_EMBEDDING_MODEL=text-embedding-3-small

APP_ENV=local
LOG_LEVEL=INFO

# Postgres (async driver). DB_STATEMENT_TIMEOUT_MS bounds every query server-side.
DATABASE_URL=postgresql+asyncpg://corral:corral@localhost:5432/corral
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_S=2

# Request handling: per-request deadline (504 past it) and per-dependency readiness probe timeout
REQUEST_TIMEOUT_S=30
READINESS_TIMEOUT_S=2

# arq worker (arq app.worker.main.WorkerSettings)
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_S=300
WORKER_MAX_TRIES=5
WORKER_SHUTDOWN_GRACE_S=20

# OpenTelemetry tracing (OTLP/HTTP). Disabled by default.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=corral-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=1.0

# Prometheus /metrics; set METRICS_TOKEN to require "Authorization: Bearer <token>"
METRICS_ENABLED=true
METRICS_TOKEN=
CORS_ORIGINS=["http://localhost:3000"]

# Must be the browser origin of the Next app. pnpm dev is :3000.
# Compose publishes the app on :3010 and sets this itself.
WORKOS_REQUEST_TIMEOUT_S=10
FRONTEND_URL=http://localhost:3000

# Session cookie
SESSION_COOKIE_NAME=wos_session
SESSION_COOKIE_MAX_AGE_S=2592000
# SESSION_COOKIE_DOMAIN=.corral.example

# Email-code sign-in rate limits (Redis). Defaults shown.
# AUTH_CODE_SEND_PER_EMAIL=3
# AUTH_CODE_SEND_WINDOW_S=60
# AUTH_CODE_VERIFY_PER_EMAIL=10
# AUTH_CODE_VERIFY_WINDOW_S=600
# AUTH_CODE_SEND_PER_IP=20
# AUTH_CODE_VERIFY_PER_IP=50
# AUTH_CODE_IP_WINDOW_S=600

# Knowledge base. Defaults shown. Postgres needs pgvector (migration 0004 creates the
# "vector" extension). Limits and the embedding provider are "Decisions for Sean" in the PR.
# KB_MAX_FILE_BYTES=26214400            # 25 MiB per file
# KB_MAX_SOURCES_PER_PRODUCT=200
# KB_MAX_BYTES_PER_PRODUCT=1073741824   # 1 GiB of originals per product
# KB_UPLOADS_PER_USER=60                # adds + re-reads per window
# KB_UPLOAD_WINDOW_S=600
# KB_DEDUPE_SCOPE=product               # product | org | off
# KB_MAX_PAGES=500
# KB_MAX_TEXT_CHARS=2000000
# KB_MIN_PAGE_CHARS=20                  # fewer = treated as a scanned page (no OCR)
# KB_PARSE_TIMEOUT_S=120
# KB_INGEST_TIMEOUT_S=900
# KB_REJECT_ACTIVE_CONTENT=true
# KB_CHUNK_CHARS=1200
# KB_CHUNK_OVERLAP_CHARS=150
# KB_EMBEDDING_PROVIDER=hashing         # hashing (local) | openai (any compatible API)
# KB_EMBEDDING_MODEL=text-embedding-3-small
# KB_EMBEDDING_API_BASE=https://api.openai.com/v1
# KB_EMBEDDING_API_KEY=
# KB_SEARCH_MAX_RESULTS=20
# KB_URL_TIMEOUT_S=15
# KB_URL_MAX_BYTES=5242880
# KB_CRAWL_MAX_PAGES=40
# KB_RESPECT_ROBOTS_TXT=true

# Lead CRM. Defaults shown; the product choices are "Decisions for Sean" in the PR.
# LEADS_IMPORT_MAX_BYTES=20971520       # 20 MiB per CSV
# LEADS_IMPORT_MAX_ROWS=50000
# LEADS_IMPORT_MAX_COLUMNS=100
# LEADS_IMPORT_MAX_FIELD_CHARS=10000
# LEADS_IMPORT_FALLBACK_ENCODING=cp1252 # when not UTF-8/UTF-16: cp1252 | latin-1 | "" (reject)
# LEADS_IMPORTS_PER_USER=20             # imports (incl. dry runs) per window
# LEADS_IMPORT_WINDOW_S=3600
# LEADS_IMPORT_TIMEOUT_S=600
# LEADS_IMPORT_BATCH_ROWS=1000
# LEADS_MAX_COMPANIES_PER_ORG=100000
# LEADS_MATCH_COMPANY_BY_NAME=true      # rows without a website join a same-name company
# LEADS_QUERY_MAX_LIMIT=200
# LEADS_MAX_RULES=20
# LEADS_BULK_MAX_IDS=1000
# LEADS_BULK_MAX_ROWS=100000
# LEADS_BULK_CONFIRM_AT=100
# LEADS_UNSUBSCRIBE_SCOPE=address       # address | company
# LEADS_POOL_SENDS_PER_DAY=210
# LEADS_REPLIED_WINDOW_DAYS=30
# LEADS_ENROLL_ALLOW_CATCH_ALL=false
