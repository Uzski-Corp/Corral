APP_ENV=local
LOG_LEVEL=INFO

# Postgres (async driver). DB_STATEMENT_TIMEOUT_MS bounds every query server-side.
DATABASE_URL=postgresql+asyncpg://corral:corral@localhost:5432/corral
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_S=2

# Request handling: per-request deadline (504 past it) and per-dependency readiness probe timeout
REQUEST_TIMEOUT_S=30
READINESS_TIMEOUT_S=2

# arq worker (arq app.worker.main.WorkerSettings)
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_S=300
WORKER_MAX_TRIES=5
WORKER_SHUTDOWN_GRACE_S=20

# OpenTelemetry tracing (OTLP/HTTP). Disabled by default.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=corral-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=1.0

# Prometheus /metrics; set METRICS_TOKEN to require "Authorization: Bearer <token>"
METRICS_ENABLED=true
METRICS_TOKEN=
CORS_ORIGINS=["http://localhost:3000"]

# WorkOS AuthKit (dashboard.workos.com). Required when APP_ENV is staging/production.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Fernet key used to seal the session cookie; generate one, see README.
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
WORKOS_REQUEST_TIMEOUT_S=10
FRONTEND_URL=http://localhost:3000

# Session cookie
SESSION_COOKIE_NAME=wos_session
SESSION_COOKIE_MAX_AGE_S=2592000
# SESSION_COOKIE_DOMAIN=.corral.example

# Email-code sign-in rate limits (Redis). Defaults shown.
# AUTH_CODE_SEND_PER_EMAIL=3
# AUTH_CODE_SEND_WINDOW_S=60
# AUTH_CODE_VERIFY_PER_EMAIL=10
# AUTH_CODE_VERIFY_WINDOW_S=600
# AUTH_CODE_SEND_PER_IP=20
# AUTH_CODE_VERIFY_PER_IP=50
# AUTH_CODE_IP_WINDOW_S=600
