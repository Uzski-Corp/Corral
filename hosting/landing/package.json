{
  "name": "corral-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "assemble": "node assemble.mjs",
    "deploy": "node assemble.mjs && cf deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply corral-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply corral-waitlist --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "cf": "1.0.0-beta.12",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
