{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corral-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  // Matches cloudflare.config.ts (what `pnpm run deploy` uses): the site lives only on the custom domain.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/_next/image", "/_next/image/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "corral-waitlist",
      "database_id": "217835f7-3973-4120-bde4-5a7d2268c917",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "corral.uzskicorp.agency",
      "custom_domain": true
    }
  ]
}
