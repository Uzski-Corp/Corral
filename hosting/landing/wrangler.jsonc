{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corral-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/_next/image", "/_next/image/*"]
  },
  "routes": [
    {
      "pattern": "corral.uzskicorp.agency",
      "custom_domain": true
    }
  ]
}
